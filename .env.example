# ============================================================
# THE LEDGER — Environment Variables (EXAMPLE — safe placeholders only)
# Copy the relevant section into backend/.env and frontend/.env.
# NEVER commit a real .env file or real private keys.
# ============================================================

# ---------- backend/.env ----------
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/the_ledger
# Optional: used only by `npm run seed` in backend/ to tag the seeded election
# with a real deployed contract address once you have one.
SEED_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ---------- frontend/.env ----------
# Address printed by `npx hardhat run scripts/deploy.js --network localhost`
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress
VITE_API_BASE_URL=http://localhost:4000/api
VITE_NETWORK_RPC_URL=http://127.0.0.1:8545
VITE_CHAIN_ID=31337

# ---------- blockchain/.env (optional — only needed for public testnet deploys) ----------
# NEVER put a real private key in a committed file. Use a throwaway testnet
# key here, sourced from your own local .env that is gitignored.
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your-project-id
# PRIVATE_KEY=0xyour_testnet_only_private_key
