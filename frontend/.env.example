# Frontend environment variables for The Ledger.
# Copy this file to .env and replace the values as needed.
# Never commit actual secrets or private keys.

VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_API_BASE_URL=http://localhost:4000/api
VITE_NETWORK_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
VITE_CHAIN_ID=11155111
# Optional: block the Voting contract was deployed at (see blockchain/scripts/deploy.js
# output). Bounds VoteCast event recovery so it never scans below this block,
# instead of scanning up to 100,000 blocks back by default. Safe to leave at 0.
VITE_DEPLOYMENT_START_BLOCK=0